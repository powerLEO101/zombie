const u32 STR_LENGTH = 2000
const u32 PROXY_DIST = 300

def isZero(field x) -> field:
	field y = if x == 0 then 1 else 0 fi
	return y

def isNotZero(field x) -> field:
	field y = if x != 0 then 1 else 0 fi
	return y

def inRange(u8 x, u8 l, u8 h) -> field:
	field y = if l <= x && x <= h then 1 else 0 fi
	return y

def spread(field[STR_LENGTH] x) -> field[STR_LENGTH]:
	field[STR_LENGTH] y = [0;STR_LENGTH]
	for u32 i in PROXY_DIST..(STR_LENGTH-PROXY_DIST) do
		field sum = 0
		for u32 j in (i-PROXY_DIST)..(i+PROXY_DIST) do
			sum = sum + x[j]
		endfor
		y[i] = sum
	endfor
	return y

def procCheck(field[STR_LENGTH] l, field[STR_LENGTH] r) -> bool:
	field[STR_LENGTH] ls = spread(l)
	for u32 i in 0..STR_LENGTH do
		assert(ls[i] * r[i] == 0)
	endfor
	return true

def parseExtract(field[STR_LENGTH] s) -> field[STR_LENGTH]:
	field[STR_LENGTH] ls = [0; STR_LENGTH]
	for u32 i in 4..STR_LENGTH do
		ls[i] = ls[i - 1] + isZero((s[i - 4] - 13) + 256 * (s[i - 3] - 10) + 65536 * (s[i - 2] - 13) + 16777216 * (s[i - 1] - 10))
	endfor
	return ls

def main(field[STR_LENGTH] t, u8[STR_LENGTH] tu) -> bool:
	field[STR_LENGTH] start = parseExtract(t)
	field accum = 0
	field[STR_LENGTH] t_0 = [0; STR_LENGTH]
	for u32 i in 0..STR_LENGTH do
		t_0[i] = isZero((t[i] - 9) * (t[i] - 10) * (t[i] - 11) * (t[i] - 12) * (t[i] - 13) * (t[i] - 32) * (t[i] - 45))
	endfor
	field[STR_LENGTH] p_2 = [0; STR_LENGTH]
	for u32 i in 0..STR_LENGTH do
		p_2[i] = 1 - t_0[i]
	endfor
	field[STR_LENGTH] t_1 = [0; STR_LENGTH]
	for u32 i in 0..STR_LENGTH do
		t_1[i] = isZero((t[i] - 48) * (t[i] - 49) * (t[i] - 50) * (t[i] - 51) * (t[i] - 52) * (t[i] - 53) * (t[i] - 54) * (t[i] - 55) * (t[i] - 56) * (t[i] - 57))
	endfor
	field[STR_LENGTH] p_3 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		p_3[i] = isZero((1 - t_1[i - 1]) + (1 - t_1[i - 0]) * 2)
	endfor
	field[STR_LENGTH] p_1 = [0; STR_LENGTH]
	for u32 i in 2..STR_LENGTH do
		p_1[i] = isZero((1 - t_1[i - 2]) + (1 - t_1[i - 1]) * 2 + (1 - t_1[i - 0]) * 4)
	endfor
	field[STR_LENGTH] t_2 = [0; STR_LENGTH]
	for u32 i in 0..STR_LENGTH do
		t_2[i] = isZero((t[i] - 9) * (t[i] - 10) * (t[i] - 11) * (t[i] - 12) * (t[i] - 13) * (t[i] - 32))
	endfor
	field[STR_LENGTH] p_5 = [0; STR_LENGTH]
	for u32 i in 10..STR_LENGTH do
		p_5[i] = isZero((1 - t_1[i - 10]) + (1 - t_1[i - 9]) * 2 + (1 - t_1[i - 8]) * 4 + (1 - t_2[i - 7]) * 8 + (1 - t_1[i - 6]) * 16 + (1 - t_1[i - 5]) * 32 + (1 - t_1[i - 4]) * 64 + (1 - t_2[i - 3]) * 128 + (1 - t_1[i - 2]) * 256 + (1 - t_1[i - 1]) * 512 + (1 - t_1[i - 0]) * 1024)
	endfor
	field[STR_LENGTH] p_4 = [0; STR_LENGTH]
	for u32 i in 3..STR_LENGTH do
		p_4[i] = isZero((1 - t_1[i - 3]) + (1 - t_1[i - 2]) * 2 + (1 - t_1[i - 1]) * 4 + (1 - t_1[i - 0]) * 8)
	endfor
	field[STR_LENGTH] p_6 = [0; STR_LENGTH]
	for u32 i in 5..STR_LENGTH do
		p_6[i] = isZero((1 - t_1[i - 5]) + (1 - t_1[i - 4]) * 2 + (1 - t_1[i - 3]) * 4 + (1 - t_1[i - 2]) * 8 + (1 - t_1[i - 1]) * 16 + (1 - t_1[i - 0]) * 32)
	endfor
	field[STR_LENGTH] t_3 = [0; STR_LENGTH]
	for u32 i in 0..STR_LENGTH do
		t_3[i] = (inRange(tu[i], 65, 122) + isZero((t[i] - 48) * (t[i] - 49) * (t[i] - 50) * (t[i] - 51) * (t[i] - 52) * (t[i] - 53) * (t[i] - 54) * (t[i] - 55) * (t[i] - 56) * (t[i] - 57))) * isZero((isZero((t[i] - 91) * (t[i] - 92) * (t[i] - 93) * (t[i] - 94) * (t[i] - 95) * (t[i] - 96))))
	endfor
	field[STR_LENGTH] p_0 = [0; STR_LENGTH]
	for u32 i in 8..STR_LENGTH do
		p_0[i] = isZero((1 - t_3[i - 8]) + (1 - t_1[i - 7]) * 2 + (1 - t_1[i - 6]) * 4 + (1 - t_1[i - 5]) * 8 + (1 - t_1[i - 4]) * 16 + (1 - t_1[i - 3]) * 32 + (1 - t_1[i - 2]) * 64 + (1 - t_1[i - 1]) * 128 + (1 - t_1[i - 0]) * 256)
	endfor
	field[STR_LENGTH] p_8 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		p_8[i] = isZero((t[i - 1] - 53) + (1 - t_1[i - 0]) * 256)
	endfor
	field[STR_LENGTH] t_4 = [0; STR_LENGTH]
	for u32 i in 0..STR_LENGTH do
		t_4[i] = isZero((t[i] - 48) * (t[i] - 49) * (t[i] - 50) * (t[i] - 51) * (t[i] - 52) * (t[i] - 53))
	endfor
	field[STR_LENGTH] p_9 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		p_9[i] = isZero((t[i - 1] - 54) + (1 - t_4[i - 0]) * 256)
	endfor
	field[STR_LENGTH] p_10 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		p_10[i] = isZero((t[i - 1] - 55) + (1 - t_1[i - 0]) * 256)
	endfor
	field[STR_LENGTH] t_5 = [0; STR_LENGTH]
	for u32 i in 0..STR_LENGTH do
		t_5[i] = isZero((t[i] - 48) * (t[i] - 49) * (t[i] - 50) * (t[i] - 51) * (t[i] - 52) * (t[i] - 53) * (t[i] - 54) * (t[i] - 55) * (t[i] - 56))
	endfor
	field[STR_LENGTH] p_11 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		p_11[i] = isZero((t[i - 1] - 56) + (1 - t_5[i - 0]) * 256)
	endfor
	field[STR_LENGTH] t_6 = [0; STR_LENGTH]
	for u32 i in 0..STR_LENGTH do
		t_6[i] = isZero((t[i] - 48) * (t[i] - 49) * (t[i] - 50))
	endfor
	field[STR_LENGTH] p_12 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		p_12[i] = isZero((t[i - 1] - 57) + (1 - t_6[i - 0]) * 256)
	endfor
	field[STR_LENGTH] p_7 = [0; STR_LENGTH]
	for u32 i in 2..STR_LENGTH do
		p_7[i] = isZero((t[i - 2] - 57) + (1 - t_1[i - 1]) * 256 + (1 - t_1[i - 0]) * 512)
	endfor
	field[STR_LENGTH] t_7 = [0; STR_LENGTH]
	for u32 i in 0..STR_LENGTH do
		t_7[i] = isZero((t[i] - 52) * (t[i] - 53) * (t[i] - 54) * (t[i] - 55) * (t[i] - 56) * (t[i] - 57))
	endfor
	field[STR_LENGTH] p_13 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		p_13[i] = isZero((t[i - 1] - 57) + (1 - t_7[i - 0]) * 256)
	endfor
	field[STR_LENGTH] f_0 = [0; STR_LENGTH]
	for u32 i in 9..STR_LENGTH do
		f_0[i] = p_0[i] * start[i - 9]
		accum = accum + f_0[i]
	endfor
	field[STR_LENGTH] s_1 = [0; STR_LENGTH]
	for u32 i in 3..STR_LENGTH do
		s_1[i] = p_1[i] * start[i - 3]
	endfor
	field[STR_LENGTH] s_2 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		s_2[i] = p_2[i] * (s_1[i - 1])
	endfor
	field[STR_LENGTH] s_4 = [0; STR_LENGTH]
	for u32 i in 2..STR_LENGTH do
		s_4[i] = p_3[i] * (s_1[i - 2] + s_2[i - 2])
	endfor
	field[STR_LENGTH] s_5 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		s_5[i] = p_2[i] * (s_4[i - 1])
	endfor
	field[STR_LENGTH] f_7 = [0; STR_LENGTH]
	for u32 i in 4..STR_LENGTH do
		f_7[i] = p_4[i] * (s_4[i - 4] + s_5[i - 4])
		accum = accum + f_7[i]
	endfor
	field[STR_LENGTH] f_8 = [0; STR_LENGTH]
	for u32 i in 11..STR_LENGTH do
		f_8[i] = p_5[i] * start[i - 11]
		accum = accum + f_8[i]
	endfor
	field[STR_LENGTH] f_9 = [0; STR_LENGTH]
	for u32 i in 6..STR_LENGTH do
		f_9[i] = p_6[i] * start[i - 6]
		accum = accum + f_9[i]
	endfor
	field[STR_LENGTH] s_10 = [0; STR_LENGTH]
	for u32 i in 3..STR_LENGTH do
		s_10[i] = p_7[i] * start[i - 3]
	endfor
	field[STR_LENGTH] s_11 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		s_11[i] = p_2[i] * (s_10[i - 1])
	endfor
	field[STR_LENGTH] s_13 = [0; STR_LENGTH]
	for u32 i in 2..STR_LENGTH do
		s_13[i] = p_8[i] * (s_10[i - 2] + s_11[i - 2])
	endfor
	field[STR_LENGTH] s_14 = [0; STR_LENGTH]
	for u32 i in 2..STR_LENGTH do
		s_14[i] = p_9[i] * (s_10[i - 2] + s_11[i - 2])
	endfor
	field[STR_LENGTH] s_15 = [0; STR_LENGTH]
	for u32 i in 2..STR_LENGTH do
		s_15[i] = p_10[i] * (s_10[i - 2] + s_11[i - 2])
	endfor
	field[STR_LENGTH] s_16 = [0; STR_LENGTH]
	for u32 i in 2..STR_LENGTH do
		s_16[i] = p_11[i] * (s_10[i - 2] + s_11[i - 2])
	endfor
	field[STR_LENGTH] s_17 = [0; STR_LENGTH]
	for u32 i in 2..STR_LENGTH do
		s_17[i] = p_12[i] * (s_10[i - 2] + s_11[i - 2])
	endfor
	field[STR_LENGTH] s_18 = [0; STR_LENGTH]
	for u32 i in 2..STR_LENGTH do
		s_18[i] = p_13[i] * (s_10[i - 2] + s_11[i - 2])
	endfor
	field[STR_LENGTH] s_20 = [0; STR_LENGTH]
	for u32 i in 1..STR_LENGTH do
		s_20[i] = p_2[i] * (s_13[i - 1] + s_14[i - 1] + s_15[i - 1] + s_16[i - 1] + s_17[i - 1] + s_18[i - 1])
	endfor
	field[STR_LENGTH] f_22 = [0; STR_LENGTH]
	for u32 i in 4..STR_LENGTH do
		f_22[i] = p_4[i] * (s_13[i - 4] + s_14[i - 4] + s_15[i - 4] + s_16[i - 4] + s_17[i - 4] + s_18[i - 4] + s_20[i - 4])
		accum = accum + f_22[i]
	endfor
	assert(accum == 0)
	return false
